    "That address doesn't look right. Copy it from Phone settings and try again.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse endereço não parece certo. Copie-o dos ajustes de Telefone e tente de novo."
